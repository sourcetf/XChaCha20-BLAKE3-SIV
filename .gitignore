# Cargo build output.  This is the big one: `target/` reached 3.3 GB here, and
# it is entirely reproducible from the sources -- never commit it.
/target/

# Python bytecode cache from tools/*.py.
__pycache__/
*.py[cod]

# Cargo's own backup files.
**/*.rs.bk

# `cargo fuzz run -workers=N` writes one log per worker into its working
# directory, which is `fuzz/` when the run is started there (as `verify.sh` and CI
# do) and the repo root otherwise. Both are run artefacts, not sources.
fuzz/fuzz-*.log
/fuzz-*.log

# Editor / OS noise.
.DS_Store
.idea/
.vscode/
*.swp
